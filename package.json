{
  "name": "tulipfarm-avatars",
  "version": "0.1.0",
  "description": "100 original object avatars in eight colors, served as static SVG and PNG files.",
  "homepage": "https://avatars.tulipfarm.ai/",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TulipFarm/avatars.git"
  },
  "bugs": {
    "url": "https://github.com/TulipFarm/avatars/issues"
  },
  "keywords": [
    "avatars",
    "object-avatars",
    "svg",
    "png",
    "static-site",
    "cloudflare-pages"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/build.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "^2.6.2",
    "pngjs": "^7.0.0",
    "svgo": "^4.0.0"
  }
}
